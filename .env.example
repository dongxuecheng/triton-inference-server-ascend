# 首次部署复制为 .env。默认 Compose 只使用镜像内置 CANN。
# A 机器使用逻辑设备 1；B 机器此前映射的空闲芯片是逻辑设备 2。
# 保留 TRITON_CANN_* 变量名，已有 .env.cann.a/.env.cann.b 可继续使用。
CANN_IMAGE=swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:9.0.0-310p-ubuntu22.04-py3.11
TRITON_BASE_IMAGE=nvcr.io/nvidia/tritonserver:24.10-py3
TRITON_CANN_IMAGE=triton-ascend-cann:24.10-cann9.0.0
TRITON_CANN_CONTAINER_NAME=triton-ascend-cann9
YOLO26_MODEL_HOST_PATH=./workspace/models/YOLO26_DET_PRE/1/yolo26s.om
# 这是 ACL 逻辑设备编号，不是 npu-smi 的 NPU 卡号或容器名称。
# 启动前对照 npu-smi info -m 和设备预检确认映射及占用。
ASCEND_DEVICE_ID=2
ASCEND_CANVAS_SLOTS=8
TRITON_HTTP_PORT=54245
TRITON_GRPC_PORT=54246
TRITON_METRICS_PORT=54247
TRITON_LOG_VERBOSE=0
