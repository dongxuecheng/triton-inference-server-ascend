# Copy to .env and adjust for your machine. docker-compose.yml reads it
# automatically.

# --- Paths -----------------------------------------------------------------
# CANN toolkit directory that contains `latest` and the versioned directories
# it points at.
ASCEND_TOOLKIT_ROOT=/home/HwHiAiUser/Ascend/ascend-toolkit

# The compiled Ascend model. It is mounted at /yolo/yolo11s.om, which is the
# path the model configs set as their `model_path`.
YOLO_MODEL_HOST_PATH=/home/HwHiAiUser/project/samples/inference/modelInference/model/yolo11s.om
YOLO_MODEL_PATH_IN_CONTAINER=/yolo/yolo11s.om

# YOLO26 needs no extra mount: its `.om` lives in the model's version directory
# and the model config points at /models/YOLO26_DET_PRE/1/yolo26s.om.

# --- Device ----------------------------------------------------------------
ASCEND_DEVICE_ID=0
# Device canvases the shared pool may hold. One is needed per in-flight
# ensemble request.
ASCEND_CANVAS_SLOTS=8

# --- Server ----------------------------------------------------------------
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.10-py3
TRITON_CONTAINER_NAME=triton-ascend
TRITON_HTTP_PORT=54245
TRITON_GRPC_PORT=54246
TRITON_METRICS_PORT=54247
TRITON_LOG_VERBOSE=0
