name: "YOLO11_DET_PRE_HOST"
backend: "yoloinfer"
max_batch_size: 0

# Same backend as yolo11_infer, but fed through the host NV12 tensor instead of
# the device handle.
parameters: {
  key: "model_path"
  value: { string_value: "/yolo/yolo11s.om" }
}
parameters: {
  key: "device_id"
  value: { string_value: "0" }
}

# Host-tensor variant for callers that already hold an NV12 canvas, such as an
# external decoder or a DVPP pipeline. The ensemble uses yolo11_infer instead,
# which consumes the device handle.
input [
  {
    name: "NV12"
    data_type: TYPE_UINT8
    dims: [ 1, 960, 640, 1 ]
  }
]

output [
  {
    name: "PREDICTIONS"
    data_type: TYPE_FP32
    dims: [ 1, 84, 8400 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
