name: "YOLO26_DET_PRE_RGB_ENSEMBLE"
platform: "ensemble"
max_batch_size: 0

# Full YOLO26 detection pipeline for a model converted *without* AIPP, so a
# client sees exactly the same inputs and outputs as
# `YOLO26_DET_PRE_ENSEMBLE`.
#
# The only difference between the two ensembles is which pair of steps carries
# the image: this one uses the RGB preprocess and inference models, while the
# other uses the NV12 ones. Because the two preprocessors share the letterbox
# geometry, the two ensembles frame the image identically and are directly
# comparable; they differ only in colour handling, and this path is the more
# faithful of the two - see "Converting without AIPP" in the README.

input [
  {
    name: "IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    name: "NUM_DETS"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "DETECTION_BOXES"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]
  },
  {
    name: "DETECTION_SCORES"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "DETECTION_CLASSES"
    data_type: TYPE_INT32
    dims: [ -1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "YOLO_640_LETTERBOX_PREPROCESS_RGB"
      model_version: -1
      input_map {
        key: "IMAGE"
        value: "IMAGE"
      }
      output_map {
        key: "RGB_CHW"
        value: "RGB_CHW"
      }
      output_map {
        key: "TRANSFORM_METADATA"
        value: "TRANSFORM_METADATA"
      }
    },
    {
      # The tensor goes to the model in host memory: unlike the NV12 canvas it
      # has no device-handle form, because it is not what the canvas pool holds.
      model_name: "YOLO26_DET_PRE_RGB"
      model_version: -1
      input_map {
        key: "RGB_CHW"
        value: "RGB_CHW"
      }
      output_map {
        key: "PREDICTIONS"
        value: "PREDICTIONS"
      }
    },
    {
      model_name: "YOLO26_DET_PRE_POSTPROCESS"
      model_version: -1
      input_map {
        key: "PREDICTIONS"
        value: "PREDICTIONS"
      }
      input_map {
        key: "TRANSFORM_METADATA"
        value: "TRANSFORM_METADATA"
      }
      output_map {
        key: "NUM_DETS"
        value: "NUM_DETS"
      }
      output_map {
        key: "DETECTION_BOXES"
        value: "DETECTION_BOXES"
      }
      output_map {
        key: "DETECTION_SCORES"
        value: "DETECTION_SCORES"
      }
      output_map {
        key: "DETECTION_CLASSES"
        value: "DETECTION_CLASSES"
      }
    }
  ]
}
