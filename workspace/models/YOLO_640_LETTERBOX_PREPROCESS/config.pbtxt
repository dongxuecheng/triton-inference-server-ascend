name: "YOLO_640_LETTERBOX_PREPROCESS"
backend: "preprocess"
max_batch_size: 0

# Preprocessing knobs. Changing any of these needs no rebuild; only the NV12
# dims below must be kept in step with target_height and target_width
# (rows = target_height * 3 / 2, columns = target_width).
# Triton's ModelParameter only carries a string, so every value is quoted.
parameters: {
  key: "target_height"
  value: { string_value: "640" }
}
parameters: {
  key: "target_width"
  value: { string_value: "640" }
}
# Neutral BT.601 limited-range gray for the letterbox border, so the static AIPP
# does not stretch a saturated edge into the network.
parameters: {
  key: "pad_luma"
  value: { string_value: "114" }
}
parameters: {
  key: "pad_chroma"
  value: { string_value: "128" }
}
# Ascend C blocks that run the kernel; 8 matches the Ascend 310P3 AI Core count.
parameters: {
  key: "kernel_blocks"
  value: { string_value: "8" }
}
# ACLLite `ProportionPasteCenter` rounds the paste offset down to an even
# coordinate, which NV12 chroma siting expects.
parameters: {
  key: "even_align"
  value: { string_value: "true" }
}

input [
  {
    name: "IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    name: "NV12"
    data_type: TYPE_UINT8
    dims: [ 1, 960, 640, 1 ]
  },
  {
    name: "NV12_REF"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    # Letterbox geometry for the postprocess backend:
    # scale_x, scale_y, pad_left, pad_top, source_width, source_height.
    name: "TRANSFORM_METADATA"
    data_type: TYPE_FP32
    dims: [ 6 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
