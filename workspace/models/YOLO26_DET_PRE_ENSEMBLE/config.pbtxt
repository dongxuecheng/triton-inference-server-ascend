name: "YOLO26_DET_PRE_ENSEMBLE"
platform: "ensemble"
max_batch_size: 0

# Full YOLO26 detection pipeline, sharing the preprocess step with the YOLO11
# ensembles. The only difference from `YOLO11_DET_PRE_ENSEMBLE` is the inference
# and postprocess pair, because YOLO26 emits finished detections instead of a
# dense tensor.

input [
  {
    name: "IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    name: "NUM_DETS"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "DETECTION_BOXES"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]
  },
  {
    name: "DETECTION_SCORES"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "DETECTION_CLASSES"
    data_type: TYPE_INT32
    dims: [ -1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "YOLO_640_LETTERBOX_PREPROCESS"
      model_version: -1
      input_map {
        key: "IMAGE"
        value: "IMAGE"
      }
      output_map {
        key: "NV12_REF"
        value: "NV12_REF"
      }
      output_map {
        key: "TRANSFORM_METADATA"
        value: "TRANSFORM_METADATA"
      }
    },
    {
      model_name: "YOLO26_DET_PRE"
      model_version: -1
      input_map {
        key: "NV12_REF"
        value: "NV12_REF"
      }
      output_map {
        key: "PREDICTIONS"
        value: "PREDICTIONS"
      }
    },
    {
      model_name: "YOLO26_DET_PRE_POSTPROCESS"
      model_version: -1
      input_map {
        key: "PREDICTIONS"
        value: "PREDICTIONS"
      }
      input_map {
        key: "TRANSFORM_METADATA"
        value: "TRANSFORM_METADATA"
      }
      output_map {
        key: "NUM_DETS"
        value: "NUM_DETS"
      }
      output_map {
        key: "DETECTION_BOXES"
        value: "DETECTION_BOXES"
      }
      output_map {
        key: "DETECTION_SCORES"
        value: "DETECTION_SCORES"
      }
      output_map {
        key: "DETECTION_CLASSES"
        value: "DETECTION_CLASSES"
      }
    }
  ]
}
