name: "YOLO_640_LETTERBOX_PREPROCESS_RGB"
backend: "rgb_preprocess"
max_batch_size: 0

# Letterbox preprocessing for a model converted *without* AIPP.
#
# The sibling model `YOLO_640_LETTERBOX_PREPROCESS` produces a packed NV12
# canvas, because its model converts and normalises that canvas inside a static
# AIPP. A model converted without `--insert_op_conf` has no AIPP, so it reads the
# ONNX image input itself: FP32, RGB, planar, scaled to [0, 1]. This model
# produces that tensor instead.
#
# Geometry is deliberately identical to the AIPP sibling - same scaling,
# centring, even alignment and border gray - so the only difference between the
# two chains is how colour is carried.
#
# Triton's ModelParameter only carries a string, so every value is quoted.
parameters: {
  key: "target_height"
  value: { string_value: "640" }
}
parameters: {
  key: "target_width"
  value: { string_value: "640" }
}
# Letterbox border as an 8 bit gray, scaled by `scale` like the image is. 114 is
# the gray the AIPP sibling fills with, so both chains see the same border.
parameters: {
  key: "pad_value"
  value: { string_value: "114" }
}
# Turns the 0-255 samples into the [0, 1] range the ONNX export expects.
parameters: {
  key: "scale"
  value: { string_value: "0.0039215686274509803921568627451" }
}
# Ascend C blocks that run the kernel; 8 matches the Ascend 310P3 AI Core count.
parameters: {
  key: "kernel_blocks"
  value: { string_value: "8" }
}
# ACLLite `ProportionPasteCenter` rounds the paste offset down to an even
# coordinate, and the AIPP path does the same, so keep them in step.
parameters: {
  key: "even_align"
  value: { string_value: "true" }
}

input [
  {
    name: "IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    # The ONNX image input of an AIPP-free model: FP32, RGB, planar. The dims
    # must stay [1, 3, target_height, target_width].
    name: "RGB_CHW"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  },
  {
    # Letterbox geometry for the postprocess backend:
    # scale_x, scale_y, pad_left, pad_top, source_width, source_height.
    name: "TRANSFORM_METADATA"
    data_type: TYPE_FP32
    dims: [ 6 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
