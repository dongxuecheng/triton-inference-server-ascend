name: "YOLO26_DET_PRE_YUV_ENSEMBLE"
platform: "ensemble"
max_batch_size: 0

# Full YOLO26 detection pipeline for a caller that already holds NV12.
#
# The input is a packed NV12 frame at its own resolution and the output is the
# same four tensors as every other detection ensemble, so a YUV pipeline can use
# one call and no colour conversion happens anywhere: the source planes are
# letterboxed straight into the canvas the model reads.
#
# The only difference from `YOLO26_DET_PRE_ENSEMBLE` is the first step's inputs.

input [
  {
    # Packed NV12: rows is 1.5x columns, the last third being interleaved U,V.
    name: "YUV"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 1 ]
  }
]

output [
  {
    name: "NUM_DETS"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "DETECTION_BOXES"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]
  },
  {
    name: "DETECTION_SCORES"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "DETECTION_CLASSES"
    data_type: TYPE_INT32
    dims: [ -1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "YUV_640_LETTERBOX_PREPROCESS"
      model_version: -1
      input_map {
        key: "YUV"
        value: "YUV"
      }
      output_map {
        key: "NV12_REF"
        value: "NV12_REF"
      }
      output_map {
        key: "TRANSFORM_METADATA"
        value: "TRANSFORM_METADATA"
      }
    },
    {
      model_name: "YOLO26_DET_PRE"
      model_version: -1
      input_map {
        key: "NV12_REF"
        value: "NV12_REF"
      }
      output_map {
        key: "PREDICTIONS"
        value: "PREDICTIONS"
      }
    },
    {
      model_name: "YOLO26_DET_PRE_POSTPROCESS"
      model_version: -1
      input_map {
        key: "PREDICTIONS"
        value: "PREDICTIONS"
      }
      input_map {
        key: "TRANSFORM_METADATA"
        value: "TRANSFORM_METADATA"
      }
      output_map {
        key: "NUM_DETS"
        value: "NUM_DETS"
      }
      output_map {
        key: "DETECTION_BOXES"
        value: "DETECTION_BOXES"
      }
      output_map {
        key: "DETECTION_SCORES"
        value: "DETECTION_SCORES"
      }
      output_map {
        key: "DETECTION_CLASSES"
        value: "DETECTION_CLASSES"
      }
    }
  ]
}
